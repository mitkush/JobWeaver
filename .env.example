# Copy to backend/.env for local development. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://jobweaver:jobweaver@localhost:5432/jobweaver
# Browser-facing URL. In development the Vite dev server proxies /api to the backend.
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application). Authorised redirect URI:
#   <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Testing-mode refresh tokens expire 7 days after consent (ADR-0006). 0 once the app is in production.
GMAIL_TOKEN_LIFETIME_DAYS=7
ADMIN_EMAILS=you@example.com
# Sign in without Google during local development only. Never enabled in production.
DEV_LOGIN_ENABLED=false

# AI Gateway (ADR-0007). "recorded" serves test fixtures and makes no AI calls.
GATEWAY_MODE=live
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_FREE_TIER=true

SCHEDULER_ENABLED=true
