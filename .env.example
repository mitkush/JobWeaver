# Copy to backend/.env for local development. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://jobweaver:jobweaver@localhost:5432/jobweaver
# Browser-facing URL. In development the Vite dev server proxies /api to the backend.
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application). Authorised redirect URI:
#   <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Testing-mode refresh tokens expire 7 days after consent (ADR-0006). 0 once the app is in production.
GMAIL_TOKEN_LIFETIME_DAYS=7
ADMIN_EMAILS=you@example.com
# Sign in without Google during local development only. Never enabled in production.
DEV_LOGIN_ENABLED=false

# AI Gateway (ADR-0007). "recorded" serves test fixtures and makes no AI calls.
GATEWAY_MODE=live
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_FREE_TIER=true

# Job Sources (Phase 2). A source without its key shows as "Not configured" on the Sources page.
# Bright Data: LinkedIn "Discover jobs by keyword" (5,000 free credits/month, 1 credit = 1 job).
BRIGHTDATA_API_KEY=
# Keep the original key above. Backups are tried in order only on credit exhaustion.
BRIGHTDATA_API_KEYS=
# Set after checking Bright Data's Free credits card; keep the primary key above.
# BRIGHTDATA_PRIMARY_PAUSED_UNTIL=2026-11-01T00:00:00Z
# RapidAPI key for JSearch (200 free requests/month). Greenhouse, Lever and Remotive need no key.
RAPIDAPI_KEY=
# Apify (Phase 5): Naukri, and LinkedIn as a standby while Bright Data is degraded.
# Both share the free $5/month. Actor inputs are written for these actors.
APIFY_TOKEN=
# Comma-separated backup tokens. Primary is checked again on each search.
APIFY_TOKENS=
APIFY_NAUKRI_ACTOR=muhammetakkurtt~naukri-job-scraper
# Full descriptions (the actor's detail mode); needed for skills and contact emails.
APIFY_NAUKRI_FETCH_DETAILS=true
# Naukri filters by numeric city ids, which are not published: check them on naukri.com.
# Unmapped cities are added to the search keywords instead. Format: {"Bengaluru": "<id>"}
APIFY_NAUKRI_CITY_IDS={}
APIFY_LINKEDIN_ACTOR=curious_coder~linkedin-jobs-scraper
# Piloterr LinkedIn search is a separate, opt-in provider (one credit per page; up to 25 jobs).
PILOTERR_API_KEY=
PILOTERR_LINKEDIN_PAGES_PER_QUERY=1
# LinkedIn geo IDs: configure city names or ISO country codes as a JSON object.
PILOTERR_LINKEDIN_GEO_IDS={"IN":"102713980"}
# SerpApi Google Jobs: standby for JSearch (250 free searches/month, 1 per results page).
SERPAPI_KEY=
SERPAPI_PAGES_PER_QUERY=1
# Adzuna (2,500 free requests/month, 250/day): register at developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Ashby, SmartRecruiters, Workable, Recruitee, Remote OK, We Work Remotely, Himalayas,
# Jobicy, Working Nomads and Hacker News need no key. Workday, Foundit and Instahyre
# ship turned off; an admin can turn them on from the Sources page.
# Daily fetch time in UTC (01:17 UTC = 06:47 IST).
FETCH_HOUR_UTC=1
FETCH_MINUTE_UTC=17
# Optional external cron fallback: POST /api/internal/fetch with header X-Cron-Secret.
INTERNAL_CRON_SECRET=
# Optional error reporting (FR-G5): a free Sentry project's DSN. Reports carry exception
# types and stack traces only; messages, bodies, cookies, headers and local variables are stripped.
SENTRY_DSN=

# Duplicate bands (FR-C1): strict defaults; tune on real data. Titles 0-100, descriptions 0-1.
# DEDUP_HIGH_TITLE=90
# DEDUP_HIGH_DESCRIPTION=0.92
# DEDUP_MEDIUM_TITLE=75
# DEDUP_MEDIUM_DESCRIPTION=0.85
# Gemini embedding pacing (free-tier per-minute limits).
# EMBEDDING_BATCH_SIZE=20
# EMBEDDING_BATCH_PAUSE_SECONDS=20
SCHEDULER_ENABLED=true
