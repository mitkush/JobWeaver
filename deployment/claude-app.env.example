# Private app configuration. Explicit operator record of this owner's acceptance.
# Default is disabled. Read PERSONAL_CLAUDE.md before accepting and enabling.
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_OWNER_ID=<your internal User UUID>
CLAUDE_CODE_WORKER_URL=http://jobweaver-claude:8080
CLAUDE_CODE_WORKER_KEY=<same random service secret, not the subscription token>
CLAUDE_CODE_CONSENT_VERSION=1
CLAUDE_CODE_CONSENT_ACCEPTED_AT=<UTC acceptance time, for example 2026-10-26T08:00:00Z>
